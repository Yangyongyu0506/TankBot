{
  "profile": "training-60hz-v1",
  "cases": [
    {
      "case_id": "unknown-field",
      "fixture": "pose-message.json",
      "layer": "schema",
      "mutation": {
        "pointer": "/secret_world",
        "value": {}
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "Envelope 禁止未知字段。"
    },
    {
      "case_id": "unsafe-integer",
      "fixture": "pose-message.json",
      "layer": "schema",
      "mutation": {
        "pointer": "/sequence_number",
        "value": 9007199254740992
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "超出 JavaScript 安全整数范围。"
    },
    {
      "case_id": "bad-covariance-shape",
      "fixture": "pose-message.json",
      "layer": "schema",
      "mutation": {
        "pointer": "/payload/covariance",
        "value": [
          1,
          2
        ]
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "协方差必须是九个数或 null。"
    },
    {
      "case_id": "invalid-yaw",
      "fixture": "pose-message.json",
      "layer": "schema",
      "mutation": {
        "pointer": "/payload/yaw_rad",
        "value": 4
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "yaw 必须处于规范的半开区间。"
    },
    {
      "case_id": "velocity-topic-with-request-id",
      "fixture": "cmd-vel-message.json",
      "layer": "schema",
      "mutation": {
        "pointer": "/request_id",
        "value": "drive-20"
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "cmd_vel 是 Topic，request_id 必须为 null，无逐条执行请求 ID。"
    },
    {
      "case_id": "payload-kind-mismatch",
      "fixture": "pose-message.json",
      "layer": "schema",
      "mutation": {
        "pointer": "/message_type",
        "value": "command"
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "Pose 负载必须是 Topic。"
    },
    {
      "case_id": "invalid-extension-name",
      "fixture": "pose-message.json",
      "layer": "schema",
      "mutation": {
        "pointer": "/extensions",
        "value": {
          "truth": 1
        }
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "扩展键必须使用 x_ 前缀。"
    },
    {
      "case_id": "hidden-object-in-view",
      "fixture": "view-snapshot.json",
      "layer": "schema",
      "mutation": {
        "pointer": "/payload/objects",
        "value": [
          {
            "x_m": 2
          }
        ]
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "v1 保留此数组为空，未来需先定义实体 Schema。"
    },
    {
      "case_id": "missing-player-source",
      "fixture": "tankbot.json",
      "layer": "schema",
      "mutation": {
        "pointer": "/pose_source/module_id",
        "value": null
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "player 模式必须显式选择来源模块。"
    },
    {
      "case_id": "invalid-trigger-list",
      "fixture": "module-contract-event.json",
      "layer": "schema",
      "mutation": {
        "pointer": "/execution/trigger_inputs",
        "value": []
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "event 模式至少有一个触发输入。"
    },
    {
      "case_id": "asymmetric-covariance",
      "fixture": "pose-message.json",
      "layer": "domain",
      "mutation": {
        "pointer": "/payload/covariance",
        "value": [
          1,
          0.1,
          0,
          0,
          1,
          0,
          0,
          0,
          1
        ]
      },
      "expected": "reject",
      "expected_code": "INVALID_COVARIANCE",
      "note": "结构应通过，但违反对称容差。"
    },
    {
      "case_id": "indefinite-covariance",
      "fixture": "pose-message.json",
      "layer": "domain",
      "mutation": {
        "pointer": "/payload/covariance",
        "value": [
          1,
          2,
          0,
          2,
          1,
          0,
          0,
          0,
          1
        ]
      },
      "expected": "reject",
      "expected_code": "INVALID_COVARIANCE",
      "note": "矩阵对称且对角非负，但不是半正定。"
    },
    {
      "case_id": "wrong-time-formula",
      "fixture": "pose-message.json",
      "layer": "domain",
      "mutation": {
        "pointer": "/simulation_time_ns",
        "value": 1999999999
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "判断时需要会话的 physics_hz。"
    },
    {
      "case_id": "wrong-run",
      "fixture": "pose-message.json",
      "layer": "domain",
      "mutation": {
        "pointer": "/run_id",
        "value": "old-run"
      },
      "expected": "reject",
      "expected_code": "WRONG_RUN",
      "note": "绑定会话当前 run 为 run-demo-001。"
    },
    {
      "case_id": "ungranted-publisher",
      "fixture": "pose-message.json",
      "layer": "domain",
      "mutation": {
        "pointer": "/publisher_id",
        "value": "sensor:imu"
      },
      "expected": "reject",
      "expected_code": "UNAUTHORIZED",
      "note": "绑定主体仅能发布配置中的候选输出端口。"
    },
    {
      "case_id": "forbidden-frame",
      "fixture": "pose-message.json",
      "layer": "domain",
      "mutation": {
        "pointer": "/frame_id",
        "value": "odom"
      },
      "expected": "reject",
      "expected_code": "INVALID_FRAME",
      "note": "本案例任务只授权 map 帧的位姿输出。"
    },
    {
      "case_id": "period-before-deadline",
      "fixture": "module-contract.json",
      "layer": "domain",
      "mutation": {
        "pointer": "/execution/period_ticks",
        "value": 3
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "调度要求 period_ticks 不小于 deadline_ticks。"
    },
    {
      "case_id": "trigger-not-an-input",
      "fixture": "module-contract-event.json",
      "layer": "domain",
      "mutation": {
        "pointer": "/execution/trigger_inputs",
        "value": [
          "missing"
        ]
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "触发器必须引用声明的输入端口。"
    },
    {
      "case_id": "unknown-port",
      "fixture": "tankbot.json",
      "layer": "domain",
      "mutation": {
        "pointer": "/connections/0/to",
        "value": "odometry.missing"
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "连接必须绑定已存在的 Contract 端口。"
    },
    {
      "case_id": "policy-invalid-age-window",
      "fixture": "view-policy.json",
      "layer": "domain",
      "mutation": {
        "pointer": "/pose_hide_after_ticks",
        "value": 6
      },
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "隐藏阈值不得早于 fresh 阈值。"
    },
    {
      "case_id": "legacy-start-time-field",
      "fixture": "cmd-vel-message.json",
      "layer": "schema",
      "mutations": [
        {
          "pointer": "/payload/apply_tick",
          "value": 126
        }
      ],
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "速度负载不接受旧起始 tick。"
    },
    {
      "case_id": "legacy-end-time-field",
      "fixture": "cmd-vel-message.json",
      "layer": "schema",
      "mutations": [
        {
          "pointer": "/payload/valid_until_tick",
          "value": 138
        }
      ],
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "速度负载不接受旧终止 tick。"
    },
    {
      "case_id": "twist-needs-vector",
      "fixture": "cmd-vel-message.json",
      "layer": "schema",
      "mutations": [
        {
          "pointer": "/payload/linear",
          "value": 0.5
        }
      ],
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "linear 是完整 Vector3，不能退回标量速度。"
    },
    {
      "case_id": "twist-needs-lateral-component",
      "fixture": "cmd-vel-message.json",
      "layer": "schema",
      "mutations": [
        {
          "pointer": "/payload/linear",
          "value": {
            "x": 0.5,
            "z": 0.0
          }
        }
      ],
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "Vector3 必须保留 y，零值也显式给出。"
    },
    {
      "case_id": "nonplanar-linear-axis",
      "fixture": "cmd-vel-message.json",
      "layer": "schema",
      "mutations": [
        {
          "pointer": "/payload/linear/z",
          "value": 1
        }
      ],
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "二维场景不支持非零 linear.z。"
    },
    {
      "case_id": "nonplanar-angular-axis",
      "fixture": "cmd-vel-message.json",
      "layer": "schema",
      "mutations": [
        {
          "pointer": "/payload/angular/x",
          "value": 1
        }
      ],
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "二维场景不支持非零 angular.x/y。"
    },
    {
      "case_id": "velocity-must-be-topic",
      "fixture": "cmd-vel-message.json",
      "layer": "schema",
      "mutations": [
        {
          "pointer": "/message_type",
          "value": "command"
        },
        {
          "pointer": "/request_id",
          "value": "drive-20"
        }
      ],
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "即使 request_id 合法，Twist 也不是离散 command。"
    },
    {
      "case_id": "velocity-frame-must-be-body",
      "fixture": "cmd-vel-message.json",
      "layer": "schema",
      "mutations": [
        {
          "pointer": "/frame_id",
          "value": "map"
        }
      ],
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "cmd_vel 固定在 base_link，地图系速度需由算法先转换。"
    },
    {
      "case_id": "controller-timeout-positive",
      "fixture": "chassis-controller.json",
      "layer": "schema",
      "mutations": [
        {
          "pointer": "/cmd_vel_timeout",
          "value": 0
        }
      ],
      "expected": "reject",
      "expected_code": "INVALID_SCHEMA",
      "note": "控制器超时配置必须为正秒数，不能关闭失联保护。"
    },
    {
      "case_id": "differential-cannot-strafe",
      "fixture": "cmd-vel-message.json",
      "layer": "domain",
      "mutations": [
        {
          "pointer": "/payload/linear/y",
          "value": 0.25
        }
      ],
      "expected": "reject",
      "expected_code": "UNSUPPORTED_MOTION",
      "note": "Schema 支持横向分量，但当前差速底盘不能横移。",
      "context": {
        "drive_model": "differential",
        "controller_tick": 126,
        "cmd_vel_timeout": 0.5
      }
    },
    {
      "case_id": "velocity-expired-at-controller",
      "fixture": "cmd-vel-message.json",
      "layer": "domain",
      "mutations": [],
      "expected": "reject",
      "expected_code": "STALE_DATA",
      "note": "生成 tick=120，60 Hz 下到 tick=150 达到配置的 0.5 s 超时；不能从接收时刻重算。",
      "context": {
        "controller_tick": 150,
        "cmd_vel_timeout": 0.5
      }
    },
    {
      "case_id": "future-velocity-stamp",
      "fixture": "cmd-vel-message.json",
      "layer": "domain",
      "mutations": [
        {
          "pointer": "/simulation_tick",
          "value": 132
        },
        {
          "pointer": "/simulation_time_ns",
          "value": 2200000000
        }
      ],
      "expected": "reject",
      "expected_code": "INVALID_TIMESTAMP",
      "note": "生成时间晚于当前 tick=126，不能用未来时间延长 watchdog。",
      "context": {
        "controller_tick": 126,
        "cmd_vel_timeout": 0.5
      }
    },
    {
      "case_id": "old-target-cannot-replace-newer",
      "fixture": "cmd-vel-message.json",
      "layer": "domain",
      "mutations": [],
      "expected": "reject",
      "expected_code": "OUT_OF_ORDER",
      "note": "已有 tick=125 的目标，tick=120 的目标即使尚未超时也不能覆盖它。",
      "context": {
        "controller_tick": 126,
        "last_target_tick": 125,
        "last_sequence_number": 19
      }
    }
  ]
}
