{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tankbot.example/schemas/v1/experiment.schema.json",
  "type": "object",
  "properties": {
    "record_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "sensor_replay"
    },
    "level_id": {
      "type": "string",
      "maxLength": 4096
    },
    "run_id": {
      "type": "string",
      "maxLength": 4096
    },
    "physics_hz": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recording_start_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "attempt_start_tick": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "deployment_tick": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string",
          "maxLength": 4096
        },
        "platform": {
          "type": "string",
          "maxLength": 4096
        },
        "machine": {
          "type": "string",
          "maxLength": 4096
        },
        "core_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime_packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          },
          "maxProperties": 16
        }
      },
      "required": [
        "python",
        "platform",
        "machine",
        "core_sha256",
        "runtime_packages"
      ],
      "additionalProperties": false
    },
    "runtime_config": {
      "type": "object",
      "maxProperties": 32
    },
    "frames": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "request": {
            "$ref": "envelope.schema.json"
          },
          "response": {
            "anyOf": [
              {
                "$ref": "envelope.schema.json"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "request",
          "response",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "code": {
              "type": "string",
              "maxLength": 4096
            },
            "logs": {
              "type": "object"
            }
          },
          "required": [
            "tick",
            "code",
            "logs"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recording": {
      "type": "boolean"
    },
    "source_files": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "record_version",
    "kind",
    "level_id",
    "run_id",
    "physics_hz",
    "seed",
    "recording_start_tick",
    "attempt_start_tick",
    "deployment_tick",
    "source_revision",
    "configuration_sha256",
    "environment",
    "runtime_config",
    "frames",
    "stop_reason",
    "failure",
    "bytes",
    "source_files"
  ],
  "additionalProperties": false
}
