{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tankbot.example/schemas/local/progress.schema.json",
  "title": "本机玩家关卡存档",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "completed_levels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "description": "完成集合按metadata.order稳定序列化，不要求是全局连续前缀；已知ID与前置条件由当前目录领域校验。"
    },
    "current_level": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "completions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "completed_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "completed_levels",
    "current_level",
    "completions"
  ],
  "additionalProperties": false
}
