{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tankbot.example/schemas/v1/chassis-profile.schema.json",
  "title": "Reusable chassis geometry and mounts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chassis_type",
    "body",
    "armor",
    "gps_mount_m",
    "visual"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "chassis_type": {
      "enum": [
        "differential",
        "omnidirectional"
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length_m",
        "width_m",
        "corner_radius_m"
      ],
      "properties": {
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "corner_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "armor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "width_m",
        "mounts_m"
      ],
      "properties": {
        "layout": {
          "const": "four_side_centers"
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mounts_m": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "gps_mount_m": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "visual": {
      "type": "object"
    }
  }
}
