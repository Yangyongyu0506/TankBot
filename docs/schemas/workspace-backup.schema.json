{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tankbot.example/schemas/v1/workspace-backup.schema.json",
  "type": "object",
  "properties": {
    "backup_version": {
      "const": "1.0"
    },
    "head_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16384,
      "propertyNames": {
        "pattern": "^(?:[a-f0-9]{64}\\.json|archive-[a-f0-9]{64}\\.json|PINS\\.json|experiments/[a-f0-9]{64}\\.json|recovery/[a-f0-9]{32}/(?:manifest|[a-f0-9]{64}|archive-[a-f0-9]{64})\\.json)$"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "backup_version",
    "head_revision",
    "entries",
    "sha256"
  ],
  "additionalProperties": false
}
