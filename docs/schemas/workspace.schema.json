{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tankbot.example/schemas/v1/workspace.schema.json",
  "title": "TankBot Workspace Manifest 1.0 草案",
  "type": "object",
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "sdk_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "protocol_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "entry_point": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "contract": {
            "type": "string",
            "pattern": "^contracts/[a-z][a-z0-9_]*\\.json$"
          },
          "config": {
            "type": "object"
          }
        },
        "required": [
          "module_id",
          "contract",
          "config"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^(/[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)*|[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*)$"
          },
          "to": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^(/[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)*|[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*)$"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "name",
          "version",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "pose_source": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "system",
            "player"
          ]
        },
        "module_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,47}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback": {
          "const": "none"
        }
      },
      "required": [
        "mode",
        "fallback"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "player"
              }
            }
          },
          "then": {
            "required": [
              "module_id"
            ],
            "properties": {
              "module_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,47}$"
              }
            }
          },
          "else": {
            "properties": {
              "module_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "manifest_version",
    "sdk_version",
    "protocol_version",
    "project_id",
    "entry_point",
    "modules",
    "connections",
    "dependencies",
    "pose_source"
  ],
  "additionalProperties": false
}
