{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tankbot.example/schemas/v1/local-navigation.schema.json",
  "$defs": {
    "task": {
      "type": "object",
      "properties": {
        "type": {
          "const": "scan_local_navigation"
        },
        "obstacle": {
          "type": "object",
          "properties": {
            "size_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_endpoint_clearance_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "max_search_nodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "random_stream": {
              "type": "string",
              "minLength": 1
            },
            "generation_version": {
              "const": "1"
            }
          },
          "required": [
            "size_m",
            "min_endpoint_clearance_m",
            "max_attempts",
            "max_search_nodes",
            "random_stream",
            "generation_version"
          ],
          "additionalProperties": false
        },
        "input_max_age_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "type",
        "obstacle",
        "input_max_age_s"
      ],
      "additionalProperties": false
    },
    "scan_parameters": {
      "type": "object",
      "properties": {
        "ray_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "angle_min_rad": {
          "type": "number"
        },
        "angle_increment_rad": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "range_min_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "range_max_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "noise_stddev_m": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "ray_count",
        "angle_min_rad",
        "angle_increment_rad",
        "range_min_m",
        "range_max_m",
        "noise_stddev_m"
      ],
      "additionalProperties": false
    }
  }
}
